{
	"name": "p-dim-popov",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"imports": {
		"#platform/*": "./src/platform/*/index.ts",
		"#features/*": "./src/features/*/index.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"serve:pages": "node scripts/serve-pages.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"boundaries": "depcruise src --config .dependency-cruiser.mjs --output-type err-long",
		"test": "vitest run",
		"check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test && pnpm build"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"dependency-cruiser": "^18.7.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
